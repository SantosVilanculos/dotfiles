{
  "breadcrumbs.enabled": false,
  "chat.disableAIFeatures": true,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.fontFamily": "Geist Mono",
  "editor.fontLigatures": "'ss11'",
  "editor.fontSize": 13,
  "editor.fontWeight": 500,
  "editor.formatOnSave": true,
  "editor.lineHeight": 24,
  "editor.lineNumbers": "relative",
  "editor.linkedEditing": true,
  "editor.minimap.enabled": false,
  "editor.minimap.renderCharacters": false,
  "editor.minimap.size": "fill",
  "editor.quickSuggestions": {
    "other": "offWhenInlineCompletions",
    "comments": "off",
    // "strings": "off",
  },
  "editor.scrollBeyondLastLine": false,
  "editor.semanticHighlighting.enabled": false,
  "editor.snippetSuggestions": "bottom",
  "editor.stickyScroll.enabled": false,
  "editor.suggestOnTriggerCharacters": false,
  "js/ts.preferences.autoImportSpecifierExcludeRegexes": ["cn", "cnfast"],
  "json.schemaDownload.trustedDomains": {
    "https://developer.microsoft.com/json-schemas/": true,
    "https://getcomposer.org/schema.json": true,
    "https://json-schema.org/": true,
    "https://json.schemastore.org/": true,
    "https://opencode.ai/config.json": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://schemastore.azurewebsites.net/": true,
    "https://ui.shadcn.com/schema.json/": true,
    "https://www.schemastore.org/": true,
    "https://www.schemastore.org/package.json": true,
    "https://www.schemastore.org/prettierrc.json": true,
  },
  "php.suggest.basic": false,
  "telemetry.feedback.enabled": false,
  "telemetry.telemetryLevel": "off",
  "terminal.integrated.fontFamily": "GeistMono Nerd Font",
  "workbench.colorTheme": "GitHub Dark",
  "workbench.editor.empty.hint": "hidden",
  "workbench.experimental.modernUI": false,
  "window.commandCenter": false,
  "workbench.activityBar.location": "top",
  "workbench.layoutControl.enabled": false,
  "workbench.sideBar.location": "right",
  //
  "containers.containerClient": "com.microsoft.visualstudio.containers.podman",
  "containers.orchestratorClient": "com.microsoft.visualstudio.orchestrators.podmancompose",
  //
  "cSpell.language": "en,pt",
  //
  "Laravel.pint.runOnSave": true,
  //
  "mermaidChart.preCommitSync.enabled": false,
  "mermaidChart.showGenerateDiagramCodeLens": false,
  //
  "vim.easymotion": true,
  "vim.incsearch": true,
  "vim.leader": "<space>",
  "vim.useCtrlKeys": true,
  "vim.useSystemClipboard": true,
  "vim.handleKeys": {
    "<C-b>": false,
    "<C-d>": false,
    "<C-f>": false,
    "<C-h>": false,
    "<C-j>": false,
    "<C-p>": false,
    "<C-w>": false,
  },
  "vim.hlsearch": true,
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": ["<leader>", "b", "d"],
      "commands": ["workbench.action.closeActiveEditor"],
      "silent": true,
    },
    {
      "before": ["<leader>", "b", "l"],
      "commands": ["workbench.action.closeEditorsToTheLeft"],
      "silent": true,
    },
    {
      "before": ["<leader>", "b", "r"],
      "commands": ["workbench.action.closeEditorsToTheRight"],
      "silent": true,
    },
    {
      "before": ["<leader>", "b", "o"],
      "commands": ["workbench.action.closeOtherEditors"],
      "silent": true,
    },
    {
      "before": ["<leader>", "f", "f"],
      "commands": ["workbench.action.quickOpen"],
      "silent": true,
    },
    {
      "before": ["<leader>", "<leader>"],
      "commands": ["workbench.action.quickOpen"],
      "silent": true,
    },
    {
      "before": ["<S-k>"],
      "commands": ["editor.action.showDefinitionPreviewHover"],
      "silent": true,
    },
    {
      "before": ["u"],
      "commands": ["undo"],
      "silent": true,
    },
    {
      "before": ["<C-r>"],
      "commands": ["redo"],
      "silent": true,
    },
    {
      "before": ["<C-a>"],
      "after": ["g", "g", "<S-v>", "G"],
      "silent": true,
    },
    {
      "before": ["[", "d"],
      "commands": ["editor.action.marker.prev"],
      "silent": true,
    },
    {
      "before": ["]", "d"],
      "commands": ["editor.action.marker.next"],
      "silent": true,
    },
  ],
  "vim.visualModeKeyBindingsNonRecursive": [
    {
      "before": ["<Tab>"],
      "after": [">", "g", "v"],
      "silent": true,
    },
    {
      "before": ["<S-Tab>"],
      "after": ["<", "g", "v"],
      "silent": true,
    },
  ],
  "extensions.experimental.affinity": {
    "vscodevim.vim": 1,
  },
  "window.menuBarVisibility": "compact",
  "workbench.browser.showInTitleBar": false,
  //
}
