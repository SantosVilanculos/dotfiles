[alias]
    nah = "!f(){ git reset --hard; git clean -df; if [ -d ".git/rebase-apply" ] || [ -d ".git/rebase-merge" ]; then git rebase --abort; fi; }; f"
    uncommit = reset --soft HEAD~1
    wip = "git add --all && git commit -m 'wip'"
[branch]
    sort = -committerdate
[column]
    ui = auto
[commit]
    verbose = true
[core]
	editor = code
    # fsmonitor = true
    # untrackedCache = true
[diff]
    algorithm = histogram
    colorMoved = plain
    mnemonicPrefix = true
    renames = true
[fetch]
    all = true
    prune = true
    pruneTags = true
[help]
    autocorrect = prompt
[init]
    defaultBranch = main
[merge]
    conflictstyle = zdiff3
[pull]
    rebase = true
[push]
    autoSetupRemote = true
    default = simple
    followTags = true
[rebase]
    autoSquash = true
    autoStash = true
    updateRefs = true
[rerere]
    autoupdate = true
    enabled = true
[tag]
    sort = version:refname
[user]
	email = santosvilanculos@yahoo.com
    name = Santos Vilanculos
