{
    "telemetry.telemetryLevel": "off",
    "update.mode": "none",
    "extensions.autoUpdate": false,
    //
    "search.exclude": {
        "**/node_modules": true,
        "**/bower_components": true,
        "**/*.code-search": true,
        ".env": false
    },
    //
    "window.commandCenter": false,
    "window.menuBarVisibility": "toggle",
    "window.title": "${activeEditorShort}",
    //
    "workbench.tree.indent": 14,
    "workbench.colorTheme": "Tokyo Night",
    "workbench.activityBar.location": "top",
    "workbench.editor.enablePreview": false,
    "workbench.iconTheme": "material-icon-theme",
    "workbench.settings.editor": "json",
    "workbench.sideBar.location": "right",
    "workbench.startupEditor": "none",
    "workbench.tree.enableStickyScroll": false,
    "workbench.colorCustomizations": {
        "[GitHub Light]": {
            "editor.background": "#f6f8fa",
            "editor.lineHighlightBackground": "#818b981f"
        }
    },
    //
    "editor.codeActionsOnSave": {
        "source.fixAll": "always",
        "source.sortImports": "always",
        "source.organizeImports": "always"
    },
    "editor.occurrencesHighlight": "off",
    "editor.renderLineHighlight": "all",
    "editor.renderWhitespace": "none",
    "editor.roundedSelection": false,
    "editor.scrollbar.horizontal": "visible",
    "editor.scrollbar.vertical": "visible",
    "editor.selectionHighlight": false,
    "editor.showFoldingControls": "always",
    "editor.colorDecorators": false,
    "editor.cursorBlinking": "solid",
    "editor.codeLens": false,
    "editor.fontFamily": "'JetBrains Mono'",
    "editor.fontLigatures": true,
    "editor.fontSize": 17.33,
    "editor.lineNumbers": "relative",
    "editor.formatOnSave": true,
    "editor.gotoLocation.multipleDeclarations": "goto",
    "editor.gotoLocation.multipleDefinitions": "goto",
    "editor.gotoLocation.multipleImplementations": "goto",
    "editor.gotoLocation.multipleReferences": "goto",
    "editor.lineHeight": 24,
    "editor.linkedEditing": true,
    "editor.minimap.enabled": false,
    "editor.quickSuggestions": {
        "other": "off",
        "comments": "off",
        "strings": "on"
    },
    "editor.quickSuggestionsDelay": 0,
    "editor.rulers": [
        80,
        120
    ],
    //   "editor.semanticTokenColorCustomizations": {
    //     "enabled": true
    //   },
    "editor.semanticHighlighting.enabled": false,
    "editor.scrollBeyondLastLine": false,
    "editor.snippetSuggestions": "bottom",
    "editor.stickyScroll.enabled": false,
    "editor.suggestOnTriggerCharacters": false,
    "editor.find.addExtraSpaceOnTop": false,
    "editor.tabCompletion": "on",
    "editor.tokenColorCustomizations": {
        "[*Light*]": {
            "textMateRules": [
                {
                    "scope": "ref.matchtext",
                    "settings": {
                        "foreground": "#000"
                    }
                }
            ]
        },
        "[*Dark*]": {
            "textMateRules": [
                {
                    "scope": "ref.matchtext",
                    "settings": {
                        "foreground": "#fff"
                    }
                }
            ]
        },
        "textMateRules": [
            {
                "scope": "comment",
                "settings": {
                    "fontStyle": "italic"
                }
            }
        ]
    },
    //
    "breadcrumbs.enabled": false,
    //
    "explorer.compactFolders": false,
    //
    "terminal.integrated.defaultProfile.linux": "zsh",
    "terminal.integrated.defaultProfile.windows": "Git Bash",
    "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font'",
    "terminal.integrated.fontSize": 17.33,
    //
    "git.autofetch": "all",
    //
    "files.associations": {
        "*.embeddedhtml": "html",
        ".env*": "dotenv"
    },
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,
    //
    "emmet.triggerExpansionOnTab": true,
    "emmet.syntaxProfiles": {
        "blade": "html"
    },
    "emmet.includeLanguages": {
        "blade": "html"
    },
    //
    "blade.format.enable": true,
    "python.analysis.fixAll": [
        "source.convertImportFormat",
        "source.unusedImports"
    ],
    "javascript.updateImportsOnFileMove.enabled": "always",
    "typescript.updateImportsOnFileMove.enabled": "always",
    "typescript.tsserver.maxTsServerMemory": 4096,
    //
    "[blade]": {
        "editor.defaultFormatter": "shufo.vscode-blade-formatter",
        "editor.autoClosingBrackets": "always"
    },
    "[css][html][javascript][markdown][json][jsonc][scss][typescript][typescriptreact][vue]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[php]": {
        "editor.defaultFormatter": "laravel.vscode-laravel"
    },
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter"
    },
    // bmewburn.vscode-intelephense-client
    // devsense.phptools-vscode
    "php.suggest.basic": false,
    // christian-kohler.path-intellisense
    "typescript.suggest.paths": false,
    "javascript.suggest.paths": false,
    // bradlc.vscode-tailwindcss
    "tailwindCSS.emmetCompletions": true,
    // pkief.material-icon-theme
    "material-icon-theme.folders.theme": "classic",
    // streetsidesoftware.code-spell-checker
    // streetsidesoftware.code-spell-checker-portuguese
    "cSpell.language": "en-US,pt-PT,lorem",
    "cSpell.enabledFileTypes": {
        "*": true
    },
    "cSpell.useGitignore": false,
    // dotenv.dotenv-vscode
    "dotenv.enableAutocloaking": false,
    // ms-python.black-formatter
    "black-formatter.importStrategy": "fromEnvironment",
    // ziglang.vscode-zig
    "zig.zls.enabled": "on",
    // vscodevim.vim
    "vim.easymotion": true,
    "vim.hlsearch": true,
    "vim.incsearch": true,
    "vim.textwidth": 120,
    "vim.useCtrlKeys": true,
    "vim.useSystemClipboard": true,
    "vim.insertModeKeyBindings": [
        {
            "before": [
                "j",
                "j"
            ],
            "after": [
                "<Esc>"
            ]
        }
    ],
    "vim.visualModeKeyBindingsNonRecursive": [
        {
            "before": [
                "<Tab>"
            ],
            "after": [
                ">",
                "g",
                "v"
            ],
            "silent": true
        },
        {
            "before": [
                "<S-Tab>"
            ],
            "after": [
                "<",
                "g",
                "v"
            ],
            "silent": true
        }
    ],
    "vim.normalModeKeyBindingsNonRecursive": [
        {
            "before": [
                "u"
            ],
            "commands": [
                "undo"
            ],
            "silent": true
        },
        {
            "before": [
                "<C-r>"
            ],
            "commands": [
                "redo"
            ],
            "silent": true
        },
        {
            "before": [
                "<S-k>"
            ],
            "commands": [
                "editor.action.showDefinitionPreviewHover"
            ],
            "silent": true
        },
        {
            "before": [
                "<C-a>"
            ],
            "after": [
                "g",
                "g",
                "<S-v>",
                "G"
            ],
            "silent": true
        },
        {
            "before": [
                "[",
                "d"
            ],
            "commands": [
                "editor.action.marker.prev"
            ],
            "silent": true
        },
        {
            "before": [
                "]",
                "d"
            ],
            "commands": [
                "editor.action.marker.next"
            ],
            "silent": true
        },
    ],
    "vim.leader": "<space>",
    "vim.handleKeys": {
        "<C-b>": false,
        "<C-d>": false,
        "<C-f>": false,
        "<C-h>": false,
        "<C-p>": false,
        "<C-space>": false,
        "<C-w>": false,
        "<C-y>": false,
        "<C-j>": false
    },
    "extensions.experimental.affinity": {
        "vscodevim.vim": 2
    },
    // esbenp.prettier-vscode
    "prettier.requireConfig": true,
    // ecmel.vscode-html-css
    "css.enabledLanguages": [
        "blade",
        "html",
        "javascript",
        "javascriptreact",
        "php",
        "typescript",
        "typescriptreact",
        "vue"
    ],
    "css.styleSheets": [
        "node_modules/@tabler/core/dist/css/*.css",
        "resources/**/*.{css,scss}",
        "src/**/*.{css,scss}"
    ],
    // formulahendry.code-runner
    "code-runner.runInTerminal": true,
    // yoshinorin.current-file-path
    "currentFilePath.defaultPathStartsFrom": "workSpace",
    // github.copilot
    "github.copilot.enable": {
        "*": false,
    },
    //...
}